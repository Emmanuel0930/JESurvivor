msgid "Debe ser un entero válido."
msgstr "Must be a valid integer."

msgid "Usuario no encontrado."
msgstr "User not found."

msgid "Error inesperado."
msgstr "Unexpected error."

msgid "Entorno no válido. Opciones: %(entornos)s"
msgstr "Invalid environment. Available options: %(entornos)s"

msgid "Reporte en proceso. Se generará en background."
msgstr "Report queued. It will be generated in the background."

msgid "No se pudo encolar la tarea. Verifica que Redis esté activo."
msgstr "Could not queue the task. Make sure Redis is running."

msgid "El servicio del equipo aliado no respondió a tiempo."
msgstr "The allied team's service did not respond in time."

msgid "No se pudo conectar con el servicio del equipo aliado."
msgstr "Could not connect to the allied team's service."

msgid "La URL del equipo aliado aún no ha sido configurada. Actualiza la variable ALIADO_API_URL en docker-compose.yml con la IP EC2 del equipo aliado."
msgstr "The allied team URL has not been configured yet. Update the ALIADO_API_URL variable in docker-compose.yml with the allied team's EC2 IP."

msgid "Plataforma de supervivencia con reservas de kits, cursos especializados y comunidad outdoor."
msgstr "Survival platform with kit reservations, specialized courses and outdoor community."

msgid "Kit de montaña"
msgstr "Mountain Kit"

msgid "Kit de selva"
msgstr "Jungle Kit"

msgid "Kit urbano"
msgstr "Urban Kit"

msgid "Kit desértico"
msgstr "Desert Kit"

msgid "Reserva confirmada"
msgstr "Reservation Confirmed"

msgid "Reserva cancelada"
msgstr "Reservation Cancelled"

msgid "Disponible"
msgstr "Available"

msgid "No disponible"
msgstr "Not Available"
